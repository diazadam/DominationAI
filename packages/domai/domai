def handle_vertex_command(command, gemini, gcp, vercel):
    """Handle commands with Vertex AI integration"""
    
    cmd_lower = command.lower()
    
    # Code generation
    if 'generate code' in cmd_lower or 'write code' in cmd_lower:
        # Extract the task
        task = command
        for prefix in ['generate code for', 'write code for', 'generate code to', 'write code to', 'generate code', 'write code']:
            task = task.replace(prefix, '', 1).strip()
        
        if not task:
            task = "a simple function"
            
        print(f"💻 Generating code: {task}")
        print("-" * 40)
        code = gemini.generate_code(task, stream=True)
        print("\n" + "-" * 40)
        
        # Save code
        timestamp = int(__import__('time').time())
        filename = f"generated_{timestamp}.py"
        with open(filename, 'w') as f:
            # Clean code for saving
            clean_code = code
            if '```python' in clean_code:
                clean_code = clean_code.split('```python')[1].split('```')[0]
            elif '```' in clean_code:
                clean_code = clean_code.split('```')[1].split('```')[0]
            f.write(clean_code)
        print(f"💾 Code saved to: {filename}")
    
    # Chat/conversation
    elif 'chat' in cmd_lower or 'ask' in cmd_lower or 'explain' in cmd_lower:
        message = command
        if cmd_lower.startswith('chat '):
            message = command[5:].strip()
        elif cmd_lower.startswith('ask '):
            message = command[4:].strip()
            
        print("💬 Gemini:", end=" ")
        gemini.chat(message, stream=True, concise=True)
    
    # Code analysis
    elif 'analyze' in cmd_lower and 'code' in cmd_lower:
        # Look for filename in command
        words = command.split()
        filename = None
        for word in words:
            if '.' in word and not word.startswith('http'):
                filename = word
                break
        
        if filename and __import__('os').path.exists(filename):
            print(f"🔍 Analyzing {filename}")
            print("-" * 30)
            with open(filename, 'r') as f:
                code = f.read()
            
            task = 'analyze'
            if 'fix' in cmd_lower:
                task = 'fix'
            elif 'optimize' in cmd_lower:
                task = 'optimize'
            elif 'review' in cmd_lower:
                task = 'review'
                
            gemini.analyze_code(code, task, stream=True)
            print("\n" + "-" * 30)
        else:
            print("❌ Please specify a valid code file to analyze")
            print("   Example: analyze code main.py")
    
    # Deployment
    elif 'deploy' in cmd_lower:
        if 'website' in cmd_lower or 'site' in cmd_lower:
            description = command.replace('deploy', '').replace('website', '').replace('site', '').strip()
            if not description:
                description = "a modern website"
            
            print(f"🏗️  Building and deploying {description}...")
            
            # Generate simple website content
            website_content = f"""<!DOCTYPE html>
<html>
<head>
    <title>{description.title()}</title>
    <style>
        body {{ font-family: system-ui; max-width: 800px; margin: 50px auto; padding: 20px; }}
        h1 {{ color: #333; }}
    </style>
</head>
<body>
    <h1>🤖 {description.title()}</h1>
    <p>This site was automatically generated and deployed by DomAI.</p>
    <p>Built on: {__import__('datetime').datetime.now().strftime('%Y-%m-%d %H:%M')}</p>
</body>
</html>"""
            
            if vercel and getattr(vercel, 'available', False):
                print("🌐 Deploying to Vercel...")
                result = vercel.deploy_website(website_content)
                if result.get('success'):
                    print(f"✅ Live at: {result.get('url')}")
                else:
                    print(f"❌ Deploy failed: {result.get('error')}")
            elif vercel:
                print("⚠️  Vercel not authenticated. Run: vercel login")
            else:
                print("❌ Vercel not available")
        else:
            print("💡 Try: 'deploy website for my portfolio'")
            print("🔧 More deployment options coming soon!")
    
    # Default
    else:
        # Only use Gemini for explicit questions or complex requests
        if any(word in cmd_lower for word in ['what', 'how', 'why', 'explain', 'help me']):
            print("💬 Gemini:", end=" ")
