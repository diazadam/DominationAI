    cmd_lower = command.lower()
    
    # Mac control commands
    if 'open application' in cmd_lower or 'open app' in cmd_lower:
        mac_control = superpower_manager.get_superpower('Mac System Control')
        if mac_control:
            app_name = command.split()[-1]  # Get last word as app name
            result = mac_control.open_application(app_name)
            print(f"🖥️  {result}")
        else:
            print("❌ Mac control not available")
    
    # Browser automation commands
    elif 'navigate to' in cmd_lower or 'open website' in cmd_lower or 'browse' in cmd_lower:
        browser = superpower_manager.get_superpower('Browser Automation')
        if browser:
            # Extract URL from command
            words = command.split()
            url = None
            for word in words:
                if 'http' in word or '.' in word:
                    url = word if word.startswith('http') else f"https://{word}"
                    break
            
            if url:
                result = browser.navigate_to(url)
                print(f"🌐 {result}")
            else:
                print("❌ Please specify a valid URL")
        else:
            print("❌ Browser control not available")
    
