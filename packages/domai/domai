def get_user_input(prompt="DomAI > "):
    """Get user input with custom prompt and escape key handling"""
    try:
        user_input = input(f"\033[1;32m{prompt}\033[0m").strip()
        # Check for escape sequences or quit commands
        if user_input.lower() in ['exit', 'quit', 'q', '\x1b', 'stop', 'sstop']:
            print("👋 Goodbye!")
            sys.exit(0)
        # Skip empty input or repeated fallback messages
        if not user_input or user_input.startswith('🔄'):
            return ""
        return user_input
    except (KeyboardInterrupt, EOFError):
        print("\n👋 Goodbye!")
        sys.exit(0)

